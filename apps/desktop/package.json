{
  "name": "kaven-file-copy-desktop",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "vite build",
    "generate:types": "node scripts/generate-types.mjs",
    "check:generated": "node scripts/generate-types.mjs --check",
    "verify": "npm run check:generated && npm run lint && npm run typecheck && npm test && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vue-tsc": "^3.0.0"
  }
}

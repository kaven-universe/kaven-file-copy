{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaven File Copy",
  "version": "0.1.3",
  "identifier": "xyz.kaven.app.copy.file",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Kaven File Copy", "width": 1100, "height": 760, "minWidth": 420, "minHeight": 480, "decorations": false, "create": false }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBRjM2NTQ0OEEwQUExMkIKUldRcm9RcUtSR1h6U3JGTUdNaXNUSC9OM3hBQ0NOaVJyeWc3V2dNYnJmbjhKb29pSXBIb1lLWm4K",
      "endpoints": [
        "https://public.data.kaven.xyz/json/kaven-file-copy/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}


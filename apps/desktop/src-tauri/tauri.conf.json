{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaven File Copy",
  "version": "0.1.0",
  "identifier": "com.kaven.filecopy",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Kaven File Copy", "width": 1100, "height": 760, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}

